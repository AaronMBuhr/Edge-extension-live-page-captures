{
  "manifest_version": 3,
  "name": "LinkedIn Job Scraper",
  "version": "1.0.10",
  "description": "Reads the full job posting from a LinkedIn job page, including company from the job header, and copies a labeled, AI-ready block to the clipboard. Shift-click Clear Buffer copies diagnostics.",
  "icons": {
    "48": "icons/icon-48x48.png",
    "96": "icons/icon-96x96.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_icon": "icons/icon-48x48.png",
    "default_popup": "popup.html",
    "default_title": "LinkedIn Job Scraper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "scrape-append": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "windows": "Alt+Shift+J",
        "mac": "Alt+Shift+J"
      },
      "description": "Scrape this job and append to the buffer"
    },
    "scrape-reset": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "windows": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Clear the buffer, then scrape this job as job 1"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["contentScript.js"]
    }
  ]
}